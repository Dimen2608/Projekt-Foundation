# Kopieren nach .env. Niemals echte Werte committen.

APP_ENV=development
LOG_LEVEL=info
PORT=3000

# Lokale Datenbank aus docker-compose
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow

# Session-Signatur. Lokal beliebiger Wert, in Produktion aus dem Secret Store.
SESSION_SECRET=
