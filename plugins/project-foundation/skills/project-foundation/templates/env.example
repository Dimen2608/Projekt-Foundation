# Environment-Variablen — Vorlage
#
# Kopieren nach .env und mit echten Werten füllen:
#   cp .env.example .env
#
# .env darf NIEMALS committet werden. Sicherstellen, dass .gitignore einen
# Eintrag ".env" enthält.
#
# Hier stehen ausschließlich Platzhalter — niemals echte Secrets.

# --- Anwendung ---
APP_ENV=development
LOG_LEVEL=info

# --- Datenbank (nur wenn RELEVANT) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Externe Dienste (nur wenn RELEVANT) ---
# API_KEY=
